# ─── Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Admins ─────────────────────────────────────────────────────────
# Comma-separated. NEXT_PUBLIC_ variant is used by the client-side navbar.
ADMIN_EMAILS=admin1@umich.edu,admin2@umich.edu
NEXT_PUBLIC_ADMIN_EMAILS=admin1@umich.edu,admin2@umich.edu

# ─── Mux (video + audio + Robots visual moderation) ────────────────
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret

# ─── Site URL (used for auth redirects and Mux CORS origin) ────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── UM-GPT (content moderation) ───────────────────────────────────
# Server-only. Get keys from https://api.toolkit.umgpt.umich.edu/
UMGPT_API_KEY=your-umgpt-api-key

# ─── Reconciler cron secret ────────────────────────────────────────
# Any long random string. Vercel Cron will automatically inject this as
# `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
# Generate with:  openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string

# All other moderation tunables (thresholds, retries, model name, etc.)
# are hardcoded in lib/env.js. Change them in code, not here.
